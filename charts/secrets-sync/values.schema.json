{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "secrets-sync values",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "storeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "SecretStore",
            "ClusterSecretStore"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generatorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "apiVersion": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string"
        },
        "engineVersion": {
          "enum": [
            "v2"
          ]
        },
        "metadata": {
          "type": "object"
        },
        "data": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "templateFrom": {
          "type": "array"
        },
        "mergePolicy": {
          "enum": [
            "Replace",
            "Merge"
          ]
        }
      }
    },
    "externalSecret": {
      "allOf": [
        {
          "$ref": "#/$defs/externalSecretBase"
        }
      ],
      "required": [
        "name"
      ]
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string"
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "type": {
          "type": "string"
        },
        "labels": {
          "type": "object"
        },
        "annotations": {
          "type": "object"
        },
        "esLabels": {
          "type": "object"
        },
        "esAnnotations": {
          "type": "object"
        },
        "data": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "refreshInterval": {
          "type": "string"
        }
      }
    },
    "externalSecretBase": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "data"
          ]
        },
        {
          "required": [
            "dataFrom"
          ]
        }
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string"
        },
        "store": {
          "oneOf": [
            {
              "$ref": "#/$defs/storeRef"
            },
            {
              "const": false
            }
          ]
        },
        "refreshInterval": {
          "type": "string",
          "pattern": "^[0-9]+(ns|us|\u00b5s|ms|s|m|h)$"
        },
        "refreshPolicy": {
          "enum": [
            "Periodic",
            "CreatedOnce",
            "OnChange"
          ]
        },
        "syncWave": {
          "type": [
            "string",
            "integer"
          ]
        },
        "labels": {
          "type": "object"
        },
        "annotations": {
          "type": "object"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "creationPolicy": {
              "enum": [
                "Owner",
                "Orphan",
                "Merge",
                "None",
                "CreateOrMerge"
              ]
            },
            "deletionPolicy": {
              "enum": [
                "Delete",
                "Merge",
                "Retain"
              ]
            },
            "immutable": {
              "type": "boolean"
            },
            "template": {
              "$ref": "#/$defs/template"
            }
          }
        },
        "data": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "secretKey",
              "remoteRef"
            ]
          }
        },
        "dataFrom": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "anyOf": [
              {
                "required": [
                  "extract"
                ]
              },
              {
                "required": [
                  "find"
                ]
              },
              {
                "required": [
                  "sourceRef"
                ]
              }
            ]
          }
        },
        "extraSpec": {
          "type": "object"
        }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "store": {
          "$ref": "#/$defs/storeRef"
        },
        "namespace": {
          "type": "string"
        },
        "refreshInterval": {
          "type": "string"
        },
        "labels": {
          "type": "object"
        },
        "annotations": {
          "type": "object"
        },
        "argocd": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "syncWaves": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "integer"
                ]
              }
            },
            "skipDryRunOnMissingResource": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "generators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "apiVersion": {
            "type": "string"
          },
          "namespace": {
            "type": "string"
          },
          "syncWave": {
            "type": [
              "string",
              "integer"
            ]
          },
          "labels": {
            "type": "object"
          },
          "annotations": {
            "type": "object"
          },
          "spec": {
            "type": "object"
          }
        }
      }
    },
    "externalSecrets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/externalSecret"
      }
    },
    "clusterExternalSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "externalSecret"
        ],
        "anyOf": [
          {
            "required": [
              "namespaces"
            ]
          },
          {
            "required": [
              "namespaceSelectors"
            ]
          }
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "namespaces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "namespaceSelectors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          },
          "refreshTime": {
            "type": "string"
          },
          "syncWave": {
            "type": [
              "string",
              "integer"
            ]
          },
          "labels": {
            "type": "object"
          },
          "annotations": {
            "type": "object"
          },
          "externalSecret": {
            "$ref": "#/$defs/externalSecretBase"
          }
        }
      }
    },
    "pushSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "data"
        ],
        "not": {
          "required": [
            "secret",
            "generatorRef"
          ]
        },
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "namespace": {
            "type": "string"
          },
          "stores": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/storeRef"
            }
          },
          "secret": {
            "type": "string",
            "minLength": 1
          },
          "generatorRef": {
            "$ref": "#/$defs/generatorRef"
          },
          "updatePolicy": {
            "enum": [
              "Replace",
              "IfNotExists"
            ]
          },
          "deletionPolicy": {
            "enum": [
              "Delete",
              "None"
            ]
          },
          "refreshInterval": {
            "type": "string"
          },
          "syncWave": {
            "type": [
              "string",
              "integer"
            ]
          },
          "labels": {
            "type": "object"
          },
          "annotations": {
            "type": "object"
          },
          "data": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "anyOf": [
                {
                  "required": [
                    "remoteKey"
                  ]
                },
                {
                  "required": [
                    "match"
                  ]
                }
              ],
              "properties": {
                "secretKey": {
                  "type": "string"
                },
                "remoteKey": {
                  "type": "string",
                  "minLength": 1
                },
                "property": {
                  "type": "string"
                },
                "metadata": {
                  "type": "object"
                },
                "conversionStrategy": {
                  "enum": [
                    "None",
                    "ReverseUnicode"
                  ]
                },
                "match": {
                  "type": "object",
                  "required": [
                    "remoteRef"
                  ]
                }
              }
            }
          },
          "template": {
            "$ref": "#/$defs/template"
          },
          "extraSpec": {
            "type": "object"
          }
        }
      }
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "remoteKey",
          "keys"
        ],
        "not": {
          "required": [
            "generator",
            "generatorRef"
          ]
        },
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "namespace": {
            "type": "string"
          },
          "remoteKey": {
            "type": "string",
            "minLength": 1
          },
          "store": {
            "$ref": "#/$defs/storeRef"
          },
          "generator": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "outputKey": {
                "type": "string"
              },
              "spec": {
                "type": "object"
              }
            }
          },
          "generatorRef": {
            "$ref": "#/$defs/generatorRef"
          },
          "keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "seedTemplate": {
            "$ref": "#/$defs/template"
          },
          "push": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "updatePolicy": {
                "enum": [
                  "Replace",
                  "IfNotExists"
                ]
              },
              "deletionPolicy": {
                "enum": [
                  "Delete",
                  "None"
                ]
              },
              "refreshInterval": {
                "type": "string"
              }
            }
          },
          "labels": {
            "type": "object"
          },
          "annotations": {
            "type": "object"
          },
          "consumers": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/consumer"
            }
          }
        }
      }
    }
  }
}
