{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "secrets-sync values",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "storeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "SecretStore",
            "ClusterSecretStore"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string"
        },
        "engineVersion": {
          "enum": [
            "v2"
          ]
        },
        "metadata": {
          "type": "object"
        },
        "data": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "templateFrom": {
          "type": "array"
        },
        "mergePolicy": {
          "enum": [
            "Replace",
            "Merge"
          ]
        }
      }
    },
    "externalSecret": {
      "allOf": [
        {
          "$ref": "#/$defs/externalSecretBase"
        }
      ],
      "required": [
        "name"
      ]
    },
    "externalSecretBase": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "data"
          ]
        },
        {
          "required": [
            "dataFrom"
          ]
        }
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string"
        },
        "store": {
          "oneOf": [
            {
              "$ref": "#/$defs/storeRef"
            },
            {
              "const": false
            }
          ]
        },
        "refreshInterval": {
          "type": "string",
          "pattern": "^[0-9]+(ns|us|\u00b5s|ms|s|m|h)$"
        },
        "refreshPolicy": {
          "enum": [
            "Periodic",
            "CreatedOnce",
            "OnChange"
          ]
        },
        "syncWave": {
          "type": [
            "string",
            "integer"
          ]
        },
        "labels": {
          "type": "object"
        },
        "annotations": {
          "type": "object"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "creationPolicy": {
              "enum": [
                "Owner",
                "Orphan",
                "Merge",
                "None",
                "CreateOrMerge"
              ]
            },
            "deletionPolicy": {
              "enum": [
                "Delete",
                "Merge",
                "Retain"
              ]
            },
            "immutable": {
              "type": "boolean"
            },
            "template": {
              "$ref": "#/$defs/template"
            }
          }
        },
        "data": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "secretKey",
              "remoteRef"
            ]
          }
        },
        "dataFrom": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "anyOf": [
              {
                "required": [
                  "extract"
                ]
              },
              {
                "required": [
                  "find"
                ]
              },
              {
                "required": [
                  "sourceRef"
                ]
              }
            ]
          }
        },
        "extraSpec": {
          "type": "object"
        }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "store": {
          "$ref": "#/$defs/storeRef"
        },
        "namespace": {
          "type": "string"
        },
        "refreshInterval": {
          "type": "string"
        },
        "labels": {
          "type": "object"
        },
        "annotations": {
          "type": "object"
        },
        "argocd": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "syncWaves": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "integer"
                ]
              }
            },
            "skipDryRunOnMissingResource": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "generators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "apiVersion": {
            "type": "string"
          },
          "namespace": {
            "type": "string"
          },
          "syncWave": {
            "type": [
              "string",
              "integer"
            ]
          },
          "labels": {
            "type": "object"
          },
          "annotations": {
            "type": "object"
          },
          "spec": {
            "type": "object"
          }
        }
      }
    },
    "externalSecrets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/externalSecret"
      }
    }
  }
}
