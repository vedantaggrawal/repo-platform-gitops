{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tenant values",
  "type": "object",
  "required": ["name", "tier", "workloads"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$", "description": "Tenant short name; namespaces tenant-<name>-<workload>, groups tenant-<name>-<role>."},
    "tier": {"type": "string", "description": "Key into .tiers"},
    "workloads": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
    "cluster": {"type": "object", "properties": {"server": {"type": "string", "format": "uri"}}},
    "tiers": {"type": "object", "additionalProperties": {"type": "object", "required": ["quota", "limitRange"],
      "properties": {"quota": {"type": "object"}, "limitRange": {"type": "object", "required": ["defaultRequest", "default", "max"]}}}},
    "namespaceLabels": {"type": "object", "additionalProperties": {"type": "string"}},
    "network": {"type": "object", "properties": {
      "ingressFromNamespaces": {"type": "array", "items": {"type": "string"}},
      "dns": {"type": "object", "required": ["namespace", "podLabels", "ports"]}}},
    "kubernetes": {"type": "object", "properties": {"groupPrefix": {"type": "string"}}},
    "roles": {"type": "object", "required": ["admin", "developer", "viewer"], "additionalProperties": {"type": "object",
      "required": ["clusterRole", "kubernetesGroup", "argocdGroup", "argocdRole", "argocdPolicies"],
      "properties": {"argocdPolicies": {"type": "array", "items": {"type": "string"}}}}},
    "argocd": {"type": "object", "properties": {
      "enabled": {"type": "boolean"}, "namespace": {"type": "string"}, "syncWave": {"type": "string"},
      "description": {"type": "string"}, "sourceRepos": {"type": "array", "items": {"type": "string"}},
      "extraDestinationNamespaces": {"type": "array", "items": {"type": "string"}},
      "namespaceResourceBlacklist": {"type": "array", "items": {"type": "object", "required": ["group", "kind"]}}}},
    "authentik": {"type": "object", "properties": {
      "enabled": {"type": "boolean"}, "namespace": {"type": "string"}, "configMapName": {"type": "string"},
      "baseUrl": {"type": "string"},
      "api": {"type": "object", "properties": {
        "enabled": {"type": "boolean"}, "clientId": {"type": "string"}, "displayName": {"type": "string"},
        "accessTokenValidity": {"type": "string"},
        "redirectUris": {"type": "array", "items": {"type": "object", "required": ["matching_mode", "url"]}}}}}}
  }
}
