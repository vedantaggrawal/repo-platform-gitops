    {
      "type": "stat",
      "title": "Gateway availability",
      "description": "99.5 % of HTTPRoute requests non-5xx",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "slo:gateway_availability:ratio_rate1h",
          "legendFormat": "Gateway availability"
        }
      ]
    },
