   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 6,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "textMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(pushsecret_status_condition{condition=\"Ready\",status=\"False\"} == 1) or vector(0)"
    }
   ]
  },
