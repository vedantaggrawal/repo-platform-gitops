  {
   "type": "stat",
   "title": "Sync errors / 10m",
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "mimir"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 18,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "textMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(externalsecret_sync_calls_error[10m])) or vector(0)"
    }
   ]
  },
  {
   "type": "table",
   "title": "ExternalSecrets / PushSecrets not Ready",
   "id": 6,
   "datasource": {
    "type": "prometheus",
    "uid": "mimir"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 6
   },
   "options": {
    "showHeader": true,
    "sortBy": [
     {
      "displayName": "Value",
      "desc": false
     }
    ]
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "instance": true,
       "job": true,
       "endpoint": true,
       "container": true,
       "service": true,
       "pod": true,
       "otel_scope_name": true,
       "otel_scope_version": true,
       "exported_namespace": true,
       "Value": true,
       "condition": true,
       "status": true
      }
     }
    }
   ],
   "targets": [
    {
     "refId": "A",
     "expr": "externalsecret_status_condition{condition=\"Ready\",status=\"False\"} == 1 or pushsecret_status_condition{condition=\"Ready\",status=\"False\"} == 1",
     "format": "table",
     "instant": true
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Sync calls/s: total vs errors",
   "id": 7,
   "datasource": {
    "type": "prometheus",
    "uid": "mimir"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(externalsecret_sync_calls_total[5m]))",
     "legendFormat": "sync calls"
    },
    {
     "refId": "B",
     "expr": "sum(rate(externalsecret_sync_calls_error[5m]))",
     "legendFormat": "errors"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Provider API calls/s by provider and status",
   "id": 8,
   "datasource": {
    "type": "prometheus",
    "uid": "mimir"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 14
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (provider, status) (rate(externalsecret_provider_api_calls_count[5m]))",
     "legendFormat": "{{provider}} {{status}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Reconcile duration p95 (s)",
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "mimir"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 14
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(externalsecret_reconcile_duration_bucket[5m])))",
     "legendFormat": "ExternalSecret"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(pushsecret_reconcile_duration_bucket[5m])))",
     "legendFormat": "PushSecret"
    }
   ]
  },
