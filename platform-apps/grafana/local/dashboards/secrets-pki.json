{
 "uid": "secrets-pki",
 "title": "Secrets & PKI",
 "tags": [
  "secrets",
  "pki",
  "security"
 ],
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "1m",
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "type": "row",
   "title": "External Secrets: is every secret syncing?",
   "id": 1,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "collapsed": false
  },
  {
   "type": "stat",
   "title": "ExternalSecrets not Ready",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "mimir"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "textMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(externalsecret_status_condition{condition=\"Ready\",status=\"False\"} == 1) or vector(0)"
    }
   ]
  },
  {
   "type": "stat",
   "title": "PushSecrets not Ready",
   "id": 3,
   "datasource": {
    "type": "prometheus",
